# Backend / Render environment. Never commit real secrets.
PORT=10000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
API_PUBLIC_URL=https://YOUR-RENDER-SERVICE.onrender.com
FRONTEND_URL=https://echoairgroup.github.io/webcontrol
EXTRA_ALLOWED_ORIGINS=https://your-custom-domain.example
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONITOR_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
